# --- Core ---
# Сгенерируй: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-in-production

# False в prod
DEBUG=True

# Через запятую. Render автодополняет своим RENDER_EXTERNAL_HOSTNAME.
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- Database ---
# Полная строка подключения. В dev можно не задавать — будет SQLite.
# Supabase Transaction Pooler: postgresql://postgres.PROJECT:PASS@aws-...pooler.supabase.com:6543/postgres
# Supabase Direct (требует IPv6 или платный addon): postgresql://postgres:PASS@db.PROJECT.supabase.co:5432/postgres
DATABASE_URL=

# --- CORS / CSRF ---
# Через запятую. Любые *.vercel.app разрешены автоматически (regex в settings.py),
# здесь нужно перечислить только дополнительные (custom-домен, локалхост и т.п.).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Supabase Storage (медиа в облаке) ---
# True — медиа уходят в Supabase Storage. False — на локальный диск.
USE_SUPABASE_STORAGE=False
SUPABASE_PROJECT_ID=
SUPABASE_BUCKET=media
SUPABASE_S3_REGION=ap-northeast-1
SUPABASE_S3_KEY_ID=
SUPABASE_S3_SECRET=

# --- Render-only (автоматически) ---
# RENDER_EXTERNAL_HOSTNAME=nashdom-backend.onrender.com
